# 복사해서 .env로 사용: cp .env.example .env
APP_ENV=local
DEBUG=true
# 실행되는 SQL을 로그로 보고 싶을 때만 true
SQL_ECHO=false

# docker compose 안에서는 host가 db, 로컬 직접 실행이면 localhost
DATABASE_URL=postgresql+asyncpg://odumak:odumak@db:5432/odumak

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# AI 기능 on/off. AI 작업 안 하는 팀원은 false로 두면 torch 설치 없이 개발 가능
ENABLE_EMBEDDING=false
EMBEDDING_MODEL_PATH=jhgan/ko-sroberta-multitask

# 구글 로그인 OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=

# 메일 발송 API (비워두면 인증코드·재설정 토큰을 서버 로그로 출력)
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=
PASSWORD_RESET_URL=
