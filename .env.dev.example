# 개발 서버용 .env 템플릿. 서버에서: cp .env.dev.example .env 후 값 채우기 (커밋 금지)
APP_ENV=dev
DEBUG=false
SQL_ECHO=false

# docker-compose.dev.yml의 db 컨테이너 접속 정보 (아래 DATABASE_URL과 맞출 것)
POSTGRES_USER=odumak
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=odumak
DATABASE_URL=postgresql+asyncpg://odumak:change-me-strong-password@db:5432/odumak

# openssl rand -hex 32 로 생성
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# FE 개발 서버·로컬 주소
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 외부에 노출할 API 포트
API_PORT=8000

# AI 기능. true로 켜려면 INSTALL_ML=true로 이미지를 빌드해야 함 (torch CPU 포함, 이미지 큼)
INSTALL_ML=false
ENABLE_EMBEDDING=false
EMBEDDING_MODEL_PATH=jhgan/ko-sroberta-multitask

GOOGLE_CLIENT_ID=
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=
PASSWORD_RESET_URL=
